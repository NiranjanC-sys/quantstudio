# =============================================================================
# @redquant/api — every environment variable the gateway reads.
#
# `src/env.ts` validates this file's keys with Zod at boot and refuses to start
# on anything invalid, so an unset required variable is a startup failure, not a
# 500 three hours later. Values shown are the defaults; only the variables in
# "Required" have none.
#
# Section numbers refer to docs/architecture/system-design.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — the process will not start without these
# -----------------------------------------------------------------------------

# Postgres 18 primary, through PgBouncer in production (§5).
DATABASE_URL=postgres://redquant_dev:redquant-dev-only-pw@127.0.0.1:5432/redquant

# Redis (cluster in production, §5): sessions, leaderboards, rate limits, caches.
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Process and cell identity
# -----------------------------------------------------------------------------

# development | test | production. Production additionally requires
# SERVICE_JWT_PRIVATE_KEY / SERVICE_JWT_PUBLIC_KEY, SESSION_COOKIE_SECURE=true,
# and unique values for CSRF_SECRET, PII_HASH_SECRET and MFA_ENCRYPTION_KEY.
# Any of those left at its development placeholder is a startup failure.
NODE_ENV=development

# §2 cell-based deployment: the cell this pod belongs to. Stamped on every metric,
# span and minted service token so a bad deploy is attributable to one cell.
CELL_ID=cell-0

# Reported by /healthz and used as the OpenTelemetry service name.
SERVICE_NAME=api-gateway

HOST=0.0.0.0
PORT=3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Largest accepted request body. Submissions are capped at 256 KiB by the schema;
# this is the transport-level backstop.
BODY_LIMIT_BYTES=1048576

# How long a SIGTERM'd pod drains in-flight requests before it is killed. Keep it
# below the orchestrator's own grace period.
SHUTDOWN_GRACE_MS=15000

# -----------------------------------------------------------------------------
# Public origins and CORS
# -----------------------------------------------------------------------------

# Public origin of this API. OAuth redirect URIs and magic-link URLs are built
# from it, so it must match what the identity providers are configured with.
API_PUBLIC_URL=http://localhost:3001

# Public origin of the web app. Post-auth and post-checkout redirects land here.
WEB_PUBLIC_URL=http://localhost:3000

# Comma-separated allowlist. Credentialed CORS forbids `*`, so this is exact.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres (§5 read/write split)
# -----------------------------------------------------------------------------

# Read-replica pool. Unset means reads go to the primary.
# DATABASE_REPLICA_URL=postgres://redquant_dev:redquant-dev-only-pw@127.0.0.1:5433/redquant

DATABASE_POOL_MAX=20
DATABASE_REPLICA_POOL_MAX=40

# Applied as both statement_timeout and the client-side query timeout.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# true verifies the server certificate; use it for any managed Postgres.
DATABASE_SSL=false

# Reads within this window of the caller's own write are routed to the primary,
# so a user always sees their own action (§5).
READ_YOUR_WRITES_WINDOW_MS=500

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Prefix for every key this service writes. Useful when several environments
# share one Redis; leave empty in a dedicated cluster.
REDIS_KEY_PREFIX=

# -----------------------------------------------------------------------------
# Sessions, CSRF and PII (§8, §11)
# -----------------------------------------------------------------------------

SESSION_COOKIE_NAME=rq_session

# §8: sliding 14 days.
SESSION_TTL_SECONDS=1209600

# Set to the parent domain to share a session across app.example.com and
# api.example.com. Leave unset for host-only cookies.
# SESSION_COOKIE_DOMAIN=.redquant.io

# MUST be true anywhere that is not localhost. Also switches HSTS on.
SESSION_COOKIE_SECURE=true

CSRF_COOKIE_NAME=rq_csrf

# HMAC key binding the double-submit CSRF token to a session. >= 32 chars.
# CHANGE THIS. The value below is a development placeholder and is published in
# this repository, so `src/env.ts` refuses to boot with NODE_ENV=production while
# any of the three keys in this section is still the placeholder.
#   openssl rand -base64 48
CSRF_SECRET=dev-only-csrf-secret-change-me-0000000000

# HMAC key used to pseudonymise IPs and user agents before they are stored or
# logged (§11: "no PII"). >= 32 chars. Rotating it orphans existing abuse
# clusters, so rotate deliberately.
PII_HASH_SECRET=dev-only-pii-hash-secret-change-me-000000

# AES-256-GCM key protecting stored TOTP seeds. >= 32 chars. Rotating it makes
# every enrolled authenticator unusable until re-enrolled.
MFA_ENCRYPTION_KEY=dev-only-mfa-encryption-key-change-me-000

# -----------------------------------------------------------------------------
# Password hashing (§8: Argon2id, m=64 MiB, t=3, p=4)
# -----------------------------------------------------------------------------

ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Internal service tokens (§8: short-lived EdDSA JWTs minted by the gateway)
# -----------------------------------------------------------------------------

# Ed25519 key pair, PKCS#8 and SPKI PEM. Required in production — the boot-time
# schema rejects NODE_ENV=production without both, because an ephemeral pair
# means each pod mints tokens the others reject. In development an ephemeral
# pair is generated per process. Newlines may be escaped as \n.
# SERVICE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# SERVICE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

SERVICE_JWT_ISSUER=https://api.redquant.io

# Comma-separated. The gateway refuses to mint a token for any other audience.
SERVICE_JWT_AUDIENCE=quantum-kernel,grader,ai-tutor

# §8 says five minutes; the schema caps this at 900.
SERVICE_JWT_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Email and magic links
# -----------------------------------------------------------------------------

MAGIC_LINK_TTL_SECONDS=900
EMAIL_FROM=no-reply@redquant.io

# console prints the message (development, tests); queue hands it to BullMQ for
# the mail worker. The gateway never talks to an SMTP server on a request path.
EMAIL_TRANSPORT=console

# -----------------------------------------------------------------------------
# WebAuthn / passkeys (§8)
# -----------------------------------------------------------------------------

# The registrable domain, without scheme or port. Passkeys are bound to it.
WEBAUTHN_RP_ID=localhost

WEBAUTHN_RP_NAME=RedQuant

# Comma-separated list of origins allowed to complete a ceremony.
WEBAUTHN_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# OIDC / OAuth providers (§8). A provider with no client id is reported as
# unconfigured by GET /auth/providers and its routes return 404.
# -----------------------------------------------------------------------------

# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# `organizations`, `common`, or a specific Entra tenant id.
OIDC_MICROSOFT_TENANT=organizations

# GitHub is not an OpenID Provider: no discovery, no ID token. The profile is
# read from the REST API after the code exchange.
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=

# ORCID, for researchers.
# OIDC_ORCID_CLIENT_ID=
# OIDC_ORCID_CLIENT_SECRET=
OIDC_ORCID_ISSUER=https://orcid.org

# OIDC_LINKEDIN_CLIENT_ID=
# OIDC_LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SAML 2.0 (§8). Per-org connections live in identity.saml_connections; these are
# the deployment-wide defaults.
# -----------------------------------------------------------------------------

SAML_SP_ENTITY_ID=https://api.redquant.io/auth/saml/metadata

# Clock skew tolerated on assertion validity windows.
SAML_ASSERTION_SKEW_SECONDS=120

# -----------------------------------------------------------------------------
# Stripe (§7). Unset means billing routes fail closed with 503 and entitlements
# fall back to the Free plan; nothing else stops working.
# -----------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids, written into billing.plans by the seed. Campus is negotiated per
# contract and usually has none.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAMS=price_...
# STRIPE_PRICE_CAMPUS=price_...

# -----------------------------------------------------------------------------
# Upstream services (§3, §4)
# -----------------------------------------------------------------------------

QUANTUM_KERNEL_URL=http://localhost:8100

# §4 budgets a synchronous T-B simulation at 900 ms.
QUANTUM_KERNEL_TIMEOUT_MS=900

AI_TUTOR_URL=http://localhost:8200
AI_TUTOR_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# AI tutor ceilings (§7, §9, §12)
# -----------------------------------------------------------------------------

# §9: hard per-user token ceiling per day, on top of the per-plan message bucket.
TUTOR_DAILY_TOKEN_CEILING=50000

# §12: cell-wide spend stop. Above it the tutor degrades to retrieval-only
# (§9 step 3) and says so in the stream's `meta` event.
TUTOR_HOURLY_COST_CEILING_USD=40

# Model prices used to account for a stream after the fact.
TUTOR_COST_PER_1K_INPUT_USD=0.003
TUTOR_COST_PER_1K_OUTPUT_USD=0.015

# -----------------------------------------------------------------------------
# Rate limiting and idempotency (§9)
# -----------------------------------------------------------------------------

# Turn off only in a load test you are deliberately trying to saturate.
RATE_LIMIT_ENABLED=true

# §9: "the gateway stores (key, user, response) in Redis for 24 h".
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Observability (§11)
# -----------------------------------------------------------------------------

OTEL_ENABLED=false

# OTLP/HTTP collector. `/v1/traces` is appended.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# §11: 1% baseline. Errors, contest submissions and payments are force-sampled.
OTEL_TRACE_SAMPLE_RATIO=0.01

# Serves GET /metrics and collects default process metrics.
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Degradation ladder (§9). These are the *defaults*; an operator flips them at
# runtime through PUT /admin/degradation, which stores an override in Redis.
# -----------------------------------------------------------------------------

# Step 1: server simulations are queued instead of answered synchronously.
DEGRADE_SIM_QUEUE_ONLY=false

# Step 2: temporary server-side qubit cap, below every plan's own ceiling.
# DEGRADE_MAX_QUBITS=22
