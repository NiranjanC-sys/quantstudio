# syntax=docker/dockerfile:1.7
#
# RedQuant `ai-tutor` image -- TS worker (docs/architecture/system-design.md
# §3): prompt assembly, RAG, streaming, cost control. Never stores PII in
# prompts. Enforces the per-hour Claude spend ceiling and the retrieval-only
# degradation fallback (§9 step 3 / DEGRADE_TUTOR_RETRIEVAL_ONLY).
#
# Per infra SPEC.md this worker lives inside the apps/api codebase as a
# separate entrypoint (not its own app directory), so this Dockerfile builds
# the same @redquant/api package as Dockerfile.api but runs a different
# process. apps/api/src currently only contains db/schema/identity.ts -- the
# tutor entrypoint has not landed yet. This Dockerfile assumes it will build
# to dist/tutor/index.js (mirroring dist/server.js for the main API); update
# CMD below once the real build output path is confirmed.
#
# Build context MUST be the monorepo root:
#   docker build -f infra/docker/Dockerfile.ai-tutor -t redquant/ai-tutor:<sha> .

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=11.21.0
ARG TURBO_VERSION=2.3.3
ARG PRUNE_SCOPE=@redquant/api

########################################################################
# base -- shared OS + toolchain layer
########################################################################
FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat tini
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

########################################################################
# pruner -- compute the minimal workspace slice needed to build the worker
########################################################################
FROM base AS pruner
ARG TURBO_VERSION
ARG PRUNE_SCOPE
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune ${PRUNE_SCOPE} --docker

########################################################################
# deps -- install deps for the pruned slice, with a persistent store cache
########################################################################
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm-store-ai-tutor,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

########################################################################
# build -- compile, then produce a self-contained production-only
# deployable subtree via `pnpm deploy` (https://pnpm.io/cli/deploy)
########################################################################
FROM deps AS build
ARG PRUNE_SCOPE
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=${PRUNE_SCOPE}...
RUN --mount=type=cache,id=pnpm-store-ai-tutor,target=/root/.local/share/pnpm/store \
    pnpm --filter=${PRUNE_SCOPE} deploy --prod /app/deploy/ai-tutor

########################################################################
# runner -- minimal, non-root, read-only-rootfs-friendly runtime
########################################################################
FROM node:${NODE_VERSION} AS runner
RUN apk add --no-cache tini
ENV NODE_ENV=production \
    PORT=3002 \
    METRICS_PORT=9464

RUN addgroup -g 10001 redquant \
    && adduser -D -H -u 10001 -G redquant redquant

WORKDIR /app
COPY --from=build --chown=redquant:redquant /app/deploy/ai-tutor ./

USER redquant:redquant

# 3002: tutor streaming endpoint (SSE/WS to the client)
# 9464: Prometheus /metrics (tutor_cost_usd_per_hour, entitlement_denial_rate)
EXPOSE 3002 9464

VOLUME ["/tmp"]

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -q -O- --tries=1 http://127.0.0.1:3002/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/tutor/index.js"]

LABEL org.opencontainers.image.title="redquant-ai-tutor" \
      org.opencontainers.image.description="RedQuant AI tutor worker: prompt assembly, RAG, streaming, cost control" \
      org.opencontainers.image.source="https://github.com/redquant/redquant" \
      org.opencontainers.image.vendor="RedQuant" \
      org.opencontainers.image.licenses="UNLICENSED"
