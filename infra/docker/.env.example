# infra/docker/.env.example
#
# Template for infra/docker/.env (local dev via `docker compose up`).
# Copy this file to `.env` and replace every CHANGEME. This is the ONLY file
# in infra/docker/ allowed to contain CHANGEME placeholders -- infra/docker/.env
# itself must hold real (dev-only) working values so `docker compose up`
# succeeds out of the box.
#
# NONE of these values are read by docker-compose.prod.yml, which sources
# real secrets via each platform's secret store instead (see
# docker-compose.prod.yml's comments) -- this file is dev-only.

# ---------------------------------------------------------------------------
# Host-side port mappings (change if something else on your machine is
# already bound to one of these)
# ---------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
API_METRICS_PORT=9464
QUANTUM_KERNEL_PORT=8100
GRADER_METRICS_PORT=9465
AI_TUTOR_PORT=3002
AI_TUTOR_METRICS_PORT=9466
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
TEMPO_PORT=3200
LOKI_PORT=3100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ---------------------------------------------------------------------------
# Postgres 18 (system-design.md §5: schema-per-domain, single logical DB)
# ---------------------------------------------------------------------------
POSTGRES_DB=redquant
POSTGRES_USER=CHANGEME
POSTGRES_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# Redis -- single node in dev. Production is a 6-shard cluster-enabled
# Redis with AOF everysec (system-design.md §5); see docker-compose.prod.yml.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# MinIO (local stand-in for S3/R2 artefact storage, §3/§10)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=CHANGEME
GRAFANA_ADMIN_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# App secrets. In staging/prod these come from external-secrets.io
# ExternalSecret resources (see infra SPEC.md conventions), never literal
# values -- local dev is the one place a literal value is acceptable.
# ---------------------------------------------------------------------------
SESSION_SECRET=CHANGEME
JWT_SIGNING_SECRET=CHANGEME
STRIPE_SECRET_KEY=CHANGEME
STRIPE_WEBHOOK_SECRET=CHANGEME
ANTHROPIC_API_KEY=CHANGEME
GOOGLE_OAUTH_CLIENT_ID=CHANGEME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGEME
GITHUB_OAUTH_CLIENT_ID=CHANGEME
GITHUB_OAUTH_CLIENT_SECRET=CHANGEME

# ---------------------------------------------------------------------------
# Observability (system-design.md §11)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=redquant-dev

# ---------------------------------------------------------------------------
# Image tag used only by docker-compose.prod.yml (image: ghcr.io/redquant/<svc>:${GIT_SHA})
# ---------------------------------------------------------------------------
GIT_SHA=CHANGEME
