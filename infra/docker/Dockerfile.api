# syntax=docker/dockerfile:1.7
#
# RedQuant `api` image -- Fastify API gateway + ws-gateway (docs/architecture/
# system-design.md §3). Owns auth, entitlements, CRUD, rate limits, job
# enqueue, and the contest/collaborative-lab websocket fanout. Never does
# heavy compute (that's quantum-kernel) and never persists ws-gateway state.
#
# Build context MUST be the monorepo root:
#   docker build -f infra/docker/Dockerfile.api -t redquant/api:<sha> .

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=11.21.0
ARG TURBO_VERSION=2.3.3
ARG PRUNE_SCOPE=@redquant/api

########################################################################
# base -- shared OS + toolchain layer
########################################################################
FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat tini
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

########################################################################
# pruner -- compute the minimal workspace slice needed to build `api`
########################################################################
FROM base AS pruner
ARG TURBO_VERSION
ARG PRUNE_SCOPE
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune ${PRUNE_SCOPE} --docker

########################################################################
# deps -- install deps for the pruned slice, with a persistent store cache
########################################################################
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm-store-api,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

########################################################################
# build -- compile TS -> dist for api + its workspace deps, then produce a
# self-contained production-only deployable subtree via `pnpm deploy`
# (the pnpm-native equivalent of `npm ci --omit=dev` for one workspace
# package: https://pnpm.io/cli/deploy). This avoids hand-rolling which
# node_modules entries are "prod" across a monorepo with workspace:* deps.
########################################################################
FROM deps AS build
ARG PRUNE_SCOPE
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=${PRUNE_SCOPE}...
RUN --mount=type=cache,id=pnpm-store-api,target=/root/.local/share/pnpm/store \
    pnpm --filter=${PRUNE_SCOPE} deploy --prod /app/deploy/api

########################################################################
# runner -- minimal, non-root, read-only-rootfs-friendly runtime
########################################################################
FROM node:${NODE_VERSION} AS runner
RUN apk add --no-cache tini
ENV NODE_ENV=production \
    PORT=3001 \
    METRICS_PORT=9464

RUN addgroup -g 10001 redquant \
    && adduser -D -H -u 10001 -G redquant redquant

WORKDIR /app
COPY --from=build --chown=redquant:redquant /app/deploy/api ./

USER redquant:redquant

# 3001: HTTP + WebSocket (contest clock, leaderboard deltas, presence)
# 9464: Prometheus /metrics
EXPOSE 3001 9464

# Writable dirs for a read-only root filesystem (tmpfs-mounted in
# docker-compose.prod.yml): /tmp for scratch, pino logs go to stdout only.
VOLUME ["/tmp"]

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -q -O- --tries=1 http://127.0.0.1:3001/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]

LABEL org.opencontainers.image.title="redquant-api" \
      org.opencontainers.image.description="RedQuant Fastify API + ws-gateway (auth, entitlements, CRUD, contest realtime)" \
      org.opencontainers.image.source="https://github.com/redquant/redquant" \
      org.opencontainers.image.vendor="RedQuant" \
      org.opencontainers.image.licenses="UNLICENSED"
