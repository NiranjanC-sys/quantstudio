      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redquant:submission_durability:ratio_rate1d{journey=\"run_lab\", environment=~\"$environment\", cell=~\"$cell\"}",
          "refId": "A",
          "legendFormat": "",
