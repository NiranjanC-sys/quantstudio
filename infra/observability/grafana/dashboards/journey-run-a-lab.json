        "options": [
          {
            "selected": false,
            "text": "dev",
            "value": "dev"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          },
          {
            "selected": true,
            "text": "prod",
            "value": "prod"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "refresh": 0,
        "skipUrlSync": false
      },
      {
        "name": "cell",
        "type": "query",
        "label": "Cell",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(redquant:journey_requests:rate5m, cell)",
          "refId": "cell-variable"
