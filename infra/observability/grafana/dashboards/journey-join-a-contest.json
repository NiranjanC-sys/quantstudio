          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "selected": false,
            "text": "dev",
            "value": "dev"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          },
          {
            "selected": true,
            "text": "prod",
            "value": "prod"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "refresh": 0,
        "skipUrlSync": false
      },
      {
        "name": "cell",
        "type": "query",
        "label": "Cell",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(redquant:journey_requests:rate5m, cell)",
          "refId": "cell-variable"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "skipUrlSync": false
      }
