        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "changes(redquant_deployment_info{environment=~\"$environment\", cell=~\"$cell\"}[$__interval]) > 0",
        "tagKeys": "service,cell",
        "titleFormat": "Deploy: {{service}}",
        "textFormat": "{{cell}} / {{environment}}"
      }
