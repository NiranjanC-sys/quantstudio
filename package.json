{
  "name": "redquant",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "kernel:dev": "cd apps/quantum-kernel && uvicorn app.main:app --reload --port 8100",
    "db:migrate": "pnpm --filter @redquant/api db:migrate",
    "loadtest": "k6 run infra/loadtest/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
