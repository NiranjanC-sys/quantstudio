{
  "name": "redquant",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "kernel:dev": "cd apps/quantum-kernel && uvicorn app.main:app --reload --port 8100",
    "db:migrate": "pnpm --filter @redquant/api db:migrate",
    "loadtest": "k6 run infra/loadtest/main.js",
    "validate:content": "node scripts/validate-content.mjs content/tracks",
    "fix:math": "node scripts/fix-split-math.mjs content/tracks",
    "check:cross-engine": "node scripts/cross-engine-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@mdx-js/mdx": "^3.1.0",
    "remark-math": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "gray-matter": "^4.0.3"
  }
}
